# Copiar para ../jornadas.env (fora da pasta do site) ou para .env e preencher.
# Também podem ser definidas como variáveis de ambiente reais do servidor.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
SESSION_NAME=jornadas_sess

# 
# ambiente
# 
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Luanda

# 
# urls
# 
BASE_URL=/jornadas-ips-2026
UPLOADS_URL=/jornadas-ips-2026/uploads

# 
# SMTP — email da instituicao
# 
SMTP_ATIVO=false
SMTP_HOST=mail.ip-ulan.ao
SMTP_PORT=587
SMTP_SEGURANCA=tls
SMTP_USER=jornadascientificas@ip-ulan.ao
SMTP_PASS=
SMTP_REMETENTE=jornadascientificas@ip-ulan.ao
SMTP_NOME=Jornadas Técnico-Científicas do IPS 2026
SMTP_REPLY_TO=jornadascientificas@ip-ulan.ao

# 
# email da instituicao 
# 
EMAIL_INSTITUCIONAL=jornadascientificas@ip-ulan.ao
WEBMAIL_URL=https://webmail.ip-ulan.ao
