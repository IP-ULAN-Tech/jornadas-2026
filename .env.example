# Copiar para ../jornadas.env (fora da pasta do site) ou para .env e preencher.
# Também podem ser definidas como variáveis de ambiente reais do servidor.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
SESSION_NAME=jornadas_sess

# Opcionais
# BASE_URL=/
# UPLOADS_DIR=/var/www/jornadas-uploads
# UPLOADS_URL=/uploads
# UPLOADS_MAX=10485760
# TIMEZONE=Africa/Luanda
